<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Schedule for the lifelog worker, like Task Scheduler on Windows: macOS (launchd) runs
  `lifelog worker --once` at login and every 5 minutes. A run still going is never overlapped.
  Install: ops/install-agent.sh com.kim.lifelog.worker
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kim.lifelog.worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--directory</string>
        <string>__REPO__</string>
        <string>lifelog</string>
        <string>worker</string>
        <string>--once</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does not read the shell's PATH; ffmpeg is in /opt/homebrew/bin. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__UV_DIR__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>Nice</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/worker.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/worker.log</string>
</dict>
</plist>
