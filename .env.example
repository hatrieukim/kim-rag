# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# Postgres and FalkorDB run with `docker compose up -d`. The defaults match docker-compose.yml.
DATABASE_URL=postgresql://lifelog:lifelog@127.0.0.1:54329/lifelog
DATA_DIR=data
TIMEZONE=Asia/Ho_Chi_Minh

# Speaker diarization runs locally with pyannote.
# 1. Create a Hugging Face account and a read token at https://huggingface.co/settings/tokens
# 2. Accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
# Without a token, set DIARIZER=none: every turn is then labelled SPEAKER_01.
DIARIZER=pyannote
HF_TOKEN=

# Speech-to-text service: gemini-3.5-transcribe (default), gpt-transcribe or chirp_3.
ASR_BACKEND=gemini-3.5-transcribe
ASR_LANGUAGE=vi
# Names and terms that come up often, comma separated. Helps the service hear them right.
ASR_KEYWORDS=

# OpenAI: for gpt-transcribe.
OPENAI_API_KEY=

# Google Cloud: for gemini-3.5-transcribe, chirp_3 and memory (embeddings + Graphiti), billed to your Cloud project.
# 1. Enable two APIs in the project: Agent Platform (Vertex AI) and Cloud Speech-to-Text.
# 2. Sign in: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# The Gemini model id. A new project may only get the `-preview` model; drop the suffix once the GA model is open.
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_LOCATION=global
CHIRP_LOCATION=us
# Fallback when GOOGLE_CLOUD_PROJECT is empty: an AI Studio key.
GEMINI_API_KEY=

# Memory (product 2). Both models are called through GOOGLE_CLOUD_PROJECT above.
# Verbatim vectors in Postgres. After changing the model run `lifelog reprocess --from index --all`.
EMBED_MODEL=gemini-embedding-2
# Graphiti on FalkorDB. GRAPH=none turns it off; episodes then stop at the `indexed` stage.
GRAPH=graphiti
# The model that extracts people, tasks and facts. After changing it run `lifelog reprocess --from ingest --all`.
GRAPH_LLM_MODEL=gemini-3.8-flash
# Only episodes starting on or after this day (YYYY-MM-DD) go into Graphiti. Empty means all.
GRAPH_SINCE=
# Zalo chats from this day (earlier than GRAPH_SINCE for chat history). Empty means GRAPH_SINCE.
GRAPH_CHAT_SINCE=
# Extra words in Zalo names that are tags, not names (e.g. where someone works), comma separated.
ZALO_NAME_TAGS=
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=63790

# Work journal (product 3). Names of the project folders whose Claude Code sessions may be read, comma
# separated, e.g. my-app,my-other-app. Empty means none is read. Session content is sent to Google to be
# summarized and embedded.
CLAUDE_CODE_PROJECTS=
CLAUDE_CODE_DIR=~/.claude/projects

# Mac activity (product 4). Commits of the projects above are read from this day on (YYYY-MM-DD).
# Empty means commits are not read.
GIT_SINCE=

# Your own email addresses, comma separated. Calendar attendees with these emails count as you, even when an
# invite (e.g. from lu.ma) went to an address other than the calendar's account.
MY_EMAILS=

# Speaker identity (product 6). Two voices with cosine similarity at or above SPEAKER_MATCH are the same person.
# Raise it if different people get merged, lower it if the same person keeps showing up as a new voice.
SPEAKER_MATCH=0.65
# Voices without a name are forgotten after this many days without being heard again.
STRANGER_KEEP_DAYS=90

# Required as soon as the server is reachable from anything but this Mac (for example the iPhone app).
# Use a long random value, e.g. `openssl rand -hex 32`, and put the same value in the clients.
API_TOKEN=
